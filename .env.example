# Alle instellingen en de eToro-keys worden via de app (Instellingen) beheerd.
# Optioneel:
# DATA_DIR=./data                 # map met portfolio.db en secret.key
# APP_SECRET=                     # vast geheim voor de versleuteling van de keys (anders /data/secret.key)
# TZ=Europe/Amsterdam
# ETORO_BASE_URL=https://public-api.etoro.com
# FX_BASE_URL=https://api.frankfurter.dev/v1
# BITCOIN_API_URL=http://umbrel.local:3006   # Esplora/mempool-API van je eigen node (Umbrel mempool-app); ook in te stellen via Instellingen
